    sub h_i1 by h_i2 bm;
    sub b_m1 by bm b_m2;
    sub j_m1 by j_m2 bm;
    sub s_m1 by s_m2 bm;
    sub S_m1 by S_m2 bm;
    sub v_m1 by v_m2 bm;
    sub e_m1 by e_m2 bm;
    sub f_m1 by f_m2 bm;
    sub g_m1 by g_m2 bm;
