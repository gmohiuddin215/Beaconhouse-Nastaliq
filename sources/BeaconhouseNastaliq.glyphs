code = "

#
# Global lookup definitions
#

lookup Ligature2 { # GSUB lookup type Ligature
    lookupflag RightToLeft;
    sub l_i1 l_m1 shad kharizabar o_f by llo;
} Ligature2;

lookup MultipleSubstitution5 { # GSUB lookup type MultipleSubstitution
    lookupflag RightToLeft IgnoreMarks;
    sub b_i1 by bi b_m2;
    sub j_i1 by j_i2 bm;
    sub s_i1 by s_i2 bm;
    sub S_i1 by S_i2 bm;
    sub v_i1 by v_i2 bm;
